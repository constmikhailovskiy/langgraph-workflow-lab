# Copy to .env and fill in.
ANTHROPIC_API_KEY=

# DRY_RUN=true makes every workflow walkable in Studio with no API key:
# each node returns a deterministic fixture instead of calling a model.
# Set to false for real runs (estimation nodes shell out to the local
# `claude` CLI under the host session; no ANTHROPIC_API_KEY needed for those).
DRY_RUN=false

# Default model for generated LLM nodes (overridable per node, see below).
MODEL_REASONING=claude-opus-4-8

# Per-node override: MODEL_<NODENAME_UPPERCASE>=<model>
# MODEL_SUMMARIZE=claude-sonnet-5
